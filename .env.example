# Copy to .env and fill in. Never commit .env.
# docker compose reads this file automatically.

# --- Database (compose manages its own postgres; these are for local runs) ---
LEDGERFLOW_DB_URL=jdbc:postgresql://localhost:5432/ledgerflow
LEDGERFLOW_DB_USER=ledgerflow
LEDGERFLOW_DB_PASSWORD=ledgerflow

# --- Kafka / Redpanda ---
LEDGERFLOW_KAFKA_BOOTSTRAP=localhost:19092

# --- Redis ---
LEDGERFLOW_REDIS_HOST=localhost
LEDGERFLOW_REDIS_PORT=6379

# --- Secrets (generate fresh values for any shared environment) ---
# openssl rand -hex 32
LEDGERFLOW_JWT_SECRET=dev-secret-change-me-in-production-please
LEDGERFLOW_WEBHOOK_SECRET=dev-webhook-secret

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
